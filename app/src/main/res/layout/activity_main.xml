<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- КОНТЕНТ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/dragonBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/dragon_cn"
            android:alpha="0.38"
            android:contentDescription="@null"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/dragon_fade"/>

        <!-- ЭКРАН ВХОДА -->
        <LinearLayout
            android:id="@+id/loginBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="30dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="三合會"
                android:textColor="@color/gold_dim"
                android:textSize="28sp"
                android:letterSpacing="0.42"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="44sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald"
                android:text="V P N"
                android:textColor="@color/gold_dim"
                android:textSize="12sp"
                android:letterSpacing="0.6"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/loginHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="48dp"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/russo"
                android:text="ВОЙТИ ЧЕРЕЗ TELEGRAM"
                android:textColor="#14110A"
                android:textSize="13sp"
                android:letterSpacing="0.2"
                android:background="@drawable/seal_button_primary"
            android:backgroundTint="@null"
                android:layout_marginTop="44dp"/>
        </LinearLayout>

        <!-- ГЛАВНЫЙ ЭКРАН VPN -->
        <LinearLayout
            android:id="@+id/mainBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="48dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="三合會"
                android:textColor="@color/gold_dim"
                android:textSize="18sp"
                android:letterSpacing="0.4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#60000000"
                android:shadowDx="0" android:shadowDy="2" android:shadowRadius="6"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/gold"
                android:alpha="0.4"
                android:layout_marginTop="12dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                android:id="@+id/btnConnect"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/auraGlow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/glow_off"
                    android:contentDescription="@null"/>

                <ImageView
                    android:id="@+id/emberGlow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ember_off"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/glyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/playfair"
                    android:text="龙"
                    android:textSize="94sp"
                    android:textColor="@color/gold_dim"
                    android:shadowColor="#AAC9A15A"
                    android:shadowDx="0" android:shadowDy="0" android:shadowRadius="22"/>

                <TextView
                    android:id="@+id/btnLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="1sp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/russo"
                android:text="ТРИАДА СПИТ"
                android:textSize="19sp"
                android:letterSpacing="0.3"
                android:textColor="@color/gold_dim"
                android:shadowColor="#80C9A15A"
                android:shadowRadius="12"/>

            <TextView
                android:id="@+id/statusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/locText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:textColor="@color/gold_dim"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:id="@+id/infoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_border"
                android:padding="16dp"
                android:layout_marginTop="18dp"/>
        </LinearLayout>

        <!-- КАБИНЕТ -->
        <ScrollView
            android:id="@+id/cabinetBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="52dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/russo"
                    android:text="КАБИНЕТ"
                    android:textColor="@color/gold_dim"
                    android:textSize="11sp"
                    android:letterSpacing="0.3"/>

                <TextView
                    android:id="@+id/sideAcc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/playfair"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <!-- HERO КАРТОЧКА -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_hero"
                    android:padding="22dp"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:id="@+id/cabCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/russo"
                    android:text="ПРОДЛЕНИЕ"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:layout_marginTop="28dp"/>

                <Button
                    android:id="@+id/btnRenewBal"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:fontFamily="@font/russo"
                    android:text="ПРОДЛИТЬ С БАЛАНСА"
                    android:textSize="12sp"
                    android:letterSpacing="0.14"
                    android:textColor="#14110A"
                    android:background="@drawable/seal_button_primary"
            android:backgroundTint="@null"
                    android:layout_marginTop="12dp"/>

                <Button
                    android:id="@+id/btnTopupWeb"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:fontFamily="@font/russo"
                    android:text="ПОПОЛНИТЬ БАЛАНС"
                    android:textSize="12sp"
                    android:letterSpacing="0.14"
                    android:textColor="@color/gold"
                    android:background="@drawable/seal_button_secondary"
                    android:layout_marginTop="10dp"
            android:backgroundTint="@null"/>

                <TextView
                    android:id="@+id/cabHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/oswald"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="14dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- НАСТРОЙКИ -->
        <LinearLayout
            android:id="@+id/settingsBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="52dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/russo"
                android:text="НАСТРОЙКИ"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:letterSpacing="0.1"/>

            <Button
                android:id="@+id/btnSupport"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:fontFamily="@font/russo"
                android:text="ПОДДЕРЖКА"
                android:textSize="12sp"
                android:letterSpacing="0.14"
                android:textColor="@color/gold"
                android:background="@drawable/seal_button_secondary"
                android:layout_marginTop="28dp"
            android:backgroundTint="@null"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:fontFamily="@font/russo"
                android:text="ВЫЙТИ ИЗ АККАУНТА"
                android:textSize="12sp"
                android:letterSpacing="0.14"
                android:textColor="@color/muted"
                android:background="@drawable/seal_button_secondary"
                android:layout_marginTop="10dp"
            android:backgroundTint="@null"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/verText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/edgeGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/edge_glow_on"
            android:scaleType="fitXY"
            android:visibility="gone"
            android:contentDescription="@null"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/smoke_overlay"
            android:alpha="0.45"
            android:contentDescription="@null"/>

    </FrameLayout>

    <!-- НИЖНЯЯ НАВИГАЦИЯ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@drawable/nav_bg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp">
            <TextView
                android:id="@+id/navVpn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="@font/russo"
                android:text="龙"
                android:textSize="22sp"
                android:textColor="@color/gold"
                android:background="@drawable/nav_item_active"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp">
            <TextView
                android:id="@+id/navCab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="@font/russo"
                android:text="КАБИНЕТ"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:textColor="@color/muted"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp">
            <TextView
                android:id="@+id/navSet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="@font/russo"
                android:text="⚙"
                android:textSize="19sp"
                android:textColor="@color/muted"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
