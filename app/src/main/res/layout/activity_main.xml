<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/dragonBg"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/dragon_cn"
        android:alpha="0.16"
        android:contentDescription="@null"/>

    <!-- ЭКРАН ВХОДА -->
    <LinearLayout
        android:id="@+id/loginBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="三合會"
            android:textColor="@color/gold_dim"
            android:textSize="25sp"
            android:letterSpacing="0.42"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:text="V P N"
            android:textColor="@color/gold_dim"
            android:textSize="11sp"
            android:letterSpacing="0.5"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/loginHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="40dp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/oswald"
            android:text="ВОЙТИ ЧЕРЕЗ TELEGRAM"
            android:textColor="#14110A"
            android:textSize="13sp"
            android:letterSpacing="0.2"
            android:backgroundTint="@color/gold"
            android:layout_marginTop="44dp"/>
    </LinearLayout>

    <!-- ГЛАВНЫЙ ЭКРАН -->
    <LinearLayout
        android:id="@+id/mainBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="56dp"
        android:paddingBottom="34dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="三合會"
            android:textColor="@color/gold_dim"
            android:textSize="21sp"
            android:letterSpacing="0.4"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <View
            android:layout_width="46dp"
            android:layout_height="1dp"
            android:background="@color/gold"
            android:alpha="0.55"
            android:layout_marginTop="14dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/btnConnect"
                android:layout_width="224dp"
                android:layout_height="224dp"
                android:layout_gravity="center"
                android:background="@drawable/ring_off"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/glyph"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair"
                        android:text="龙"
                        android:textSize="78sp"
                        android:textColor="@color/gold_dim"/>

                    <TextView
                        android:id="@+id/btnLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/oswald"
                        android:text="ПОДКЛЮЧИТЬ"
                        android:textSize="11sp"
                        android:letterSpacing="0.3"
                        android:textColor="@color/gold"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:text="ТРИАДА СПИТ"
            android:textSize="14sp"
            android:letterSpacing="0.26"
            android:textColor="@color/gold_dim"/>

        <TextView
            android:id="@+id/statusSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:textSize="11sp"
            android:textColor="@color/muted"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:id="@+id/infoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_border"
            android:padding="18dp"
            android:layout_marginTop="28dp"/>
    </LinearLayout>
</FrameLayout>
