<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/dragonBg"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/dragon_cn"
        android:alpha="0.16"
        android:contentDescription="@null"/>

    <!-- ЭКРАН ВХОДА -->
    <LinearLayout
        android:id="@+id/loginBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="三合會"
            android:textColor="@color/gold_dim"
            android:textSize="25sp"
            android:letterSpacing="0.42"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:text="V P N"
            android:textColor="@color/gold_dim"
            android:textSize="11sp"
            android:letterSpacing="0.5"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/loginHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="40dp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/russo"
            android:text="ВОЙТИ ЧЕРЕЗ TELEGRAM"
            android:textColor="#14110A"
            android:textSize="13sp"
            android:letterSpacing="0.2"
            android:backgroundTint="@color/gold"
            android:layout_marginTop="44dp"/>
    </LinearLayout>

    <!-- ГЛАВНЫЙ ЭКРАН -->
    <LinearLayout
        android:id="@+id/mainBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="56dp"
        android:paddingBottom="34dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="三合會"
            android:textColor="@color/gold_dim"
            android:textSize="21sp"
            android:letterSpacing="0.4"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <View
            android:layout_width="46dp"
            android:layout_height="1dp"
            android:background="@color/gold"
            android:alpha="0.55"
            android:layout_marginTop="14dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/btnConnect"
                android:layout_width="224dp"
                android:layout_height="224dp"
                android:layout_gravity="center"
                android:background="@drawable/ring_off"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/glyph"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair"
                        android:text="龙"
                        android:textSize="78sp"
                        android:textColor="@color/gold_dim"/>

                    <TextView
                        android:id="@+id/btnLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/russo"
                        android:text="ПОДКЛЮЧИТЬ"
                        android:textSize="11sp"
                        android:letterSpacing="0.3"
                        android:textColor="@color/gold"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/russo"
            android:text="ТРИАДА СПИТ"
            android:textSize="14sp"
            android:letterSpacing="0.26"
            android:textColor="@color/gold_dim"/>

        <TextView
            android:id="@+id/statusSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:textSize="11sp"
            android:textColor="@color/muted"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/locText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:textColor="@color/gold_dim"
            android:layout_marginTop="6dp"/>

        <LinearLayout
            android:id="@+id/infoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_border"
            android:padding="18dp"
            android:layout_marginTop="22dp"/>
    </LinearLayout>

    <!-- КАБИНЕТ -->
    <ScrollView
        android:id="@+id/cabinetBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="76dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/russo"
                android:text="ЛИЧНЫЙ КАБИНЕТ"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:letterSpacing="0.1"/>

            <LinearLayout
                android:id="@+id/cabCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_border"
                android:padding="18dp"
                android:layout_marginTop="22dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/russo"
                android:text="ПРОДЛЕНИЕ"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:letterSpacing="0.16"
                android:layout_marginTop="30dp"/>

            <Button
                android:id="@+id/btnRenewBal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="@font/russo"
                android:text="ПРОДЛИТЬ С БАЛАНСА"
                android:textSize="12sp"
                android:letterSpacing="0.14"
                android:textColor="#14110A"
                android:backgroundTint="@color/gold"
                android:layout_marginTop="14dp"/>

            <Button
                android:id="@+id/btnTopupWeb"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="@font/russo"
                android:text="ПОПОЛНИТЬ БАЛАНС"
                android:textSize="12sp"
                android:letterSpacing="0.14"
                android:textColor="@color/gold"
                android:background="@drawable/card_border"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/cabHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oswald"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- НАСТРОЙКИ -->
    <LinearLayout
        android:id="@+id/settingsBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="76dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/russo"
            android:text="НАСТРОЙКИ"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:letterSpacing="0.1"/>

        <Button
            android:id="@+id/btnSupport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:fontFamily="@font/russo"
            android:text="ПОДДЕРЖКА"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:textColor="@color/gold"
            android:background="@drawable/card_border"
            android:layout_marginTop="24dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:fontFamily="@font/russo"
            android:text="ВЫЙТИ ИЗ АККАУНТА"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:textColor="@color/muted"
            android:background="@drawable/card_border"
            android:layout_marginTop="10dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/verText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- ГАМБУРГЕР -->
    <FrameLayout
        android:id="@+id/burger"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/burger_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Меню">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="\u2630"
            android:textSize="18sp"
            android:textColor="@color/gold"/>
    </FrameLayout>

    <!-- ЗАТЕМНЕНИЕ -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true"/>

    <!-- БОКОВОЕ МЕНЮ -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="264dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/sidebar_bg"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="56dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"/>

        <TextView
            android:id="@+id/sideAcc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:textColor="@color/gold_dim"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26C9A15A"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/navVpn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:fontFamily="@font/russo"
            android:text="VPN"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:letterSpacing="0.12"
            android:background="@drawable/menu_item"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/navCab"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:fontFamily="@font/russo"
            android:text="ЛИЧНЫЙ КАБИНЕТ"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:letterSpacing="0.12"
            android:background="@drawable/menu_item"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/navSet"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:fontFamily="@font/russo"
            android:text="НАСТРОЙКИ"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:letterSpacing="0.12"
            android:background="@drawable/menu_item"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="4dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="三合會"
            android:textColor="#4A4136"
            android:textSize="15sp"
            android:letterSpacing="0.3"/>
    </LinearLayout>

</FrameLayout>
