            <solid android:color="#1A3FD9A0"/>
            <size android:width="240dp" android:height="240dp"/>
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#081210"/>
            <stroke android:width="1.5dp" android:color="#663FD9A0"/>
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="#060E0C"/>
            <stroke android:width="1dp" android:color="#333FD9A0"/>
        </shape>
    </item>
</layer-list>
