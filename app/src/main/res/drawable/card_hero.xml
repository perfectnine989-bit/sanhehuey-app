<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#141F18"
                android:centerColor="#0D1612" android:endColor="#07100C"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#44C9A15A"/>
            <corners android:radius="20dp"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>
